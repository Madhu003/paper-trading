PORT=5001
# From MongoDB Atlas: Connect → Drivers
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB=paper_trading
JWT_SECRET=replace_me_with_a_long_random_secret
# Ignored by the app for now: Redis is an in-memory Map mock in src/redis.ts (no TCP).
REDIS_URL=redis://localhost:6379

